:root{
    --bg:#0A0E14; --card:#11161F; --card2:#0D1119; --border:#1C2330; --border2:#2A3241;
    --text:#E5E9F0; --text2:#C7CEDA; --muted:#8892A3; --faint:#5C6577; --dim:#3A4353;
    --cyan:#22D3EE; --violet:#8B5CF6; --red:#EF4444; --amber:#F59E0B; --green:#22C55E;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{
    background:var(--bg); color:var(--text); font-family:'Inter',system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .font-display{font-family:'Space Grotesk',sans-serif;}
  .font-mono{font-family:'JetBrains Mono',monospace;}
  ::selection{background:#22D3EE33;}
  ::-webkit-scrollbar{width:8px; height:8px;}
  ::-webkit-scrollbar-thumb{background:var(--border2); border-radius:8px;}
  a,button{font-family:inherit; color:inherit;}
  button{cursor:pointer; background:none; border:none;}
  input{font-family:inherit; color:inherit;}
  button:focus-visible, input:focus-visible, [tabindex]:focus-visible{outline:2px solid var(--cyan); outline-offset:2px;}
  svg.icon{display:inline-block; vertical-align:middle; flex-shrink:0;}

  /* ---------- layout ---------- */
  #app{display:flex; min-height:100vh; width:100%;}
  .sidebar{
    position:fixed; top:0; left:0; height:100%; width:256px; background:var(--card2);
    border-right:1px solid var(--border); display:flex; flex-direction:column; z-index:50;
    transform:translateX(-100%); transition:transform .2s ease;
  }
  .sidebar.open{transform:translateX(0);}
  .sidebar-scrim{position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:40; display:none;}
  .sidebar-scrim.show{display:block;}
  .sidebar-head{height:64px; display:flex; align-items:center; gap:8px; padding:0 20px; border-bottom:1px solid var(--border);}
  .logo{
    position:relative; width:28px; height:28px; border-radius:6px; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,#22D3EE33,#8B5CF633); border:1px solid #22D3EE4d;
  }
  .logo svg:first-child{color:#67e8f9; width:15px; height:15px; position:relative; z-index:1;}
  .logo svg:last-child{position:absolute; color:#22d3ee66; width:26px; height:26px;}
  .brand{font-size:15px; font-weight:600; letter-spacing:-0.01em;}
  .brand span{color:var(--cyan);}
  .nav{flex:1; padding:16px 12px; display:flex; flex-direction:column; gap:2px;}
  .nav-item{
    display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:8px; font-size:14px;
    color:var(--muted); border:1px solid transparent; transition:.15s; width:100%; text-align:left; font-weight:500;
  }
  .nav-item:hover{color:var(--text); background:rgba(255,255,255,.05);}
  .nav-item.active{background:#22D3EE1a; color:#67e8f9; border-color:#22D3EE33;}
  .nav-item .chev{margin-left:auto; opacity:.6;}
  .sidebar-foot{padding:16px; border-top:1px solid var(--border);}
  .status-pill{display:flex; align-items:center; gap:10px; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:10px 12px;}
  .dot-wrap{position:relative; width:8px; height:8px;}
  .dot-ping{position:absolute; inset:0; border-radius:50%; background:var(--green); opacity:.6; animation:ping 1.6s cubic-bezier(0,0,.2,1) infinite;}
  .dot-core{position:relative; width:8px; height:8px; border-radius:50%; background:var(--green);}
  @keyframes ping{75%,100%{transform:scale(2.2); opacity:0;}}
  .status-text{font-size:12px;}
  .status-text .t1{font-weight:500; color:var(--text);}
  .status-text .t2{color:var(--faint);}

  .main-col{flex:1; display:flex; flex-direction:column; min-width:0;}
  .topbar{
    height:64px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between;
    padding:0 16px; flex-shrink:0; background:rgba(10,14,20,.9); backdrop-filter:blur(8px); position:sticky; top:0; z-index:30;
  }
  .tb-left, .tb-right{display:flex; align-items:center; gap:8px;}
  .mobile-menu-btn{display:flex; padding:8px; margin-left:-8px; color:var(--muted);}
  .cmdk{
    display:none; align-items:center; gap:8px; font-size:14px; color:var(--faint); background:var(--card);
    border:1px solid var(--border); border-radius:8px; padding:6px 12px; width:224px; transition:.15s;
  }
  .cmdk:hover{border-color:var(--border2);}
  .cmdk kbd{margin-left:auto; font-size:10px; font-family:'JetBrains Mono',monospace; background:var(--border); padding:2px 6px; border-radius:4px;}
  .tb-btn{display:flex; align-items:center; gap:6px; font-size:14px; color:var(--muted); padding:6px 12px; border-radius:8px; transition:.15s;}
  .tb-btn:hover{color:var(--text); background:rgba(255,255,255,.05);}
  .tb-btn.primary{background:#22D3EE1a; color:#67e8f9; border:1px solid #22D3EE40; font-weight:500;}
  .tb-btn.primary:hover{background:#22D3EE26;}
  .icon-btn{position:relative; padding:8px; color:var(--muted); border-radius:8px; transition:.15s;}
  .icon-btn:hover{color:var(--text); background:rgba(255,255,255,.05);}
  .notif-dot{position:absolute; top:6px; right:6px; width:6px; height:6px; border-radius:50%; background:var(--cyan);}
  .avatar{
    width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg,var(--cyan),var(--violet));
    display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:600; color:var(--bg); margin-left:4px;
  }

  main{flex:1; overflow-y:auto;}
  .page{padding:40px 20px; max-width:1120px; margin:0 auto; animation:fadeUp .4s ease both;}
  .page.narrow{max-width:960px;}
  .page.xnarrow{max-width:720px;}
  .page.wide{max-width:1200px;}
  @keyframes fadeUp{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);}}

  .mobile-nav{display:flex; border-top:1px solid var(--border); background:var(--card2);}
  .mobile-nav button{flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; padding:10px 0; font-size:10px; color:var(--faint);}
  .mobile-nav button.active{color:#67e8f9;}

  /* ---------- generic bits ---------- */
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px; font-size:12px; font-family:'JetBrains Mono',monospace; color:#67e8f9;
    background:#22D3EE1a; border:1px solid #22D3EE33; border-radius:999px; padding:5px 12px; margin-bottom:20px;
  }
  .eyebrow.violet{color:#c4b5fd; background:#8B5CF61a; border-color:#8B5CF633;}
  .pulse-dot{width:6px; height:6px; border-radius:50%; background:var(--cyan); animation:pulseDot 1.6s ease-in-out infinite;}
  @keyframes pulseDot{0%,100%{opacity:.4; transform:scale(.9);} 50%{opacity:1; transform:scale(1.15);}}
  h1.page-title{font-family:'Space Grotesk',sans-serif; font-weight:600; letter-spacing:-.02em; font-size:32px;}
  .page-sub{color:var(--muted); margin-top:8px; font-size:15px;}
  .mono-sub{font-family:'JetBrains Mono',monospace; color:var(--muted); margin-top:8px; font-size:13px;}
  .demo-label{font-size:10px; color:var(--faint); font-family:'JetBrains Mono',monospace; margin-top:12px;}

  .btn{border-radius:8px; font-size:14px; font-weight:600; padding:12px 20px; display:inline-flex; align-items:center; gap:8px; transition:.15s;}
  .btn-primary{background:var(--cyan); color:var(--bg);}
  .btn-primary:hover{background:#67e8f9;}
  .btn-primary:disabled{background:var(--border); color:var(--faint); cursor:not-allowed;}
  .btn-outline{border:1px solid var(--border2); color:var(--text);}
  .btn-outline:hover{background:rgba(255,255,255,.05);}
  .btn-ghost-red{background:#EF44441a; color:#fca5a5; border:1px solid #EF444440; font-weight:500; font-size:14px; padding:10px 18px; border-radius:8px;}
  .btn-ghost-red:hover{background:#EF444426;}
  .btn-ghost-cyan{background:#22D3EE1a; color:#67e8f9; border:1px solid #22D3EE40; font-weight:500; font-size:13px; padding:8px 14px; border-radius:8px;}
  .btn-ghost-cyan:hover{background:#22D3EE26;}
  .chip{font-size:12px; padding:6px 12px; border-radius:999px; border:1px solid var(--border); color:var(--muted); transition:.15s;}
  .chip:hover{color:var(--text);}
  .chip.red-hover:hover{border-color:#ef444466; color:#fca5a5;}
  .chip.amber-hover:hover{border-color:#f59e0b66; color:#fcd34d;}
  .chip.green-hover:hover{border-color:#22c55e66; color:#86efac;}

  .card{background:var(--card); border:1px solid var(--border); border-radius:12px;}

  /* stats grid */
  .stat-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:16px; margin-top:32px;}
  .stat{background:var(--card); border:1px solid var(--border); border-radius:12px; padding:16px;}
  .stat .val{font-family:'Space Grotesk',sans-serif; font-size:24px; font-weight:600;}
  .stat .lbl{font-size:12px; color:var(--faint); margin-top:4px;}
  .stat svg.icon{margin-bottom:12px;}

  /* landing hero */
  .hero{display:grid; grid-template-columns:1fr; gap:48px; align-items:center;}
  .hero h1{font-size:40px; line-height:1.05;}
  .hero .tagline{font-family:'Space Grotesk',sans-serif; font-size:24px; margin-top:12px; color:var(--text2); letter-spacing:-.01em;}
  .hero p.desc{color:var(--muted); margin-top:20px; font-size:16px; line-height:1.6; max-width:480px;}
  .hero-actions{display:flex; flex-wrap:wrap; gap:12px; margin-top:32px;}
  .browser-wrap{position:relative;}
  .browser-glow{position:absolute; inset:-32px; background:radial-gradient(circle at 30% 20%,#22D3EE1a,transparent 60%),radial-gradient(circle at 80% 80%,#8B5CF61a,transparent 60%); filter:blur(30px); border-radius:50%;}
  .browser{position:relative; background:var(--card); border:1px solid var(--border); border-radius:12px; overflow:hidden; box-shadow:0 25px 50px -12px rgba(0,0,0,.5);}
  .browser-bar{display:flex; align-items:center; gap:6px; padding:12px 16px; border-bottom:1px solid var(--border); background:var(--card2);}
  .browser-dot{width:10px; height:10px; border-radius:50%; background:var(--border2);}
  .browser-url{flex:1; display:flex; align-items:center; gap:8px; background:var(--bg); border-radius:6px; padding:6px 12px; margin-left:12px;}
  .browser-url span{font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .browser-body{padding:28px; min-height:260px; display:flex; flex-direction:column; justify-content:center;}
  .scan-log{display:flex; flex-direction:column; gap:10px; font-family:'JetBrains Mono',monospace; font-size:14px; margin-bottom:20px;}
  .scan-log .row{display:flex; align-items:center; gap:8px; color:var(--dim); animation:fadeUp .4s ease both;}
  .scan-log .row.active{color:#67e8f9;}
  .scan-log .row.done{color:var(--dim);}
  .spinner{width:12px; height:12px; border-radius:50%; border:2px solid var(--cyan); border-top-color:transparent; animation:spin .7s linear infinite; display:inline-block;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .hero-result{border-top:1px solid var(--border); padding-top:20px; animation:fadeUp .4s ease both;}
  .hero-result .score{font-family:'Space Grotesk',sans-serif; font-size:48px; font-weight:700; color:var(--red);}
  .hero-result .of100{font-family:'JetBrains Mono',monospace; color:var(--faint); font-size:13px;}
  .risk-badge{display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; border-radius:999px; padding:5px 10px; border:1px solid; margin:8px 0;}
  .risk-badge.high{color:#f87171; background:#EF44441a; border-color:#EF444450;}
  .risk-badge.medium{color:#fbbf24; background:#F59E0B1a; border-color:#F59E0B50;}
  .risk-badge.low{color:#4ade80; background:#22C55E1a; border-color:#22C55E50;}

  /* scanner */
  .scan-input-row{display:flex; flex-direction:column; gap:12px;}
  .url-field{flex:1; display:flex; align-items:center; gap:8px; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:12px 16px; transition:.15s;}
  .url-field:focus-within{border-color:#22D3EE80;}
  .url-field input{background:transparent; border:none; outline:none; flex:1; font-size:14px; font-family:'JetBrains Mono',monospace;}
  .url-field input::placeholder{color:var(--faint);}
  .example-row{display:flex; flex-wrap:wrap; gap:8px; margin-top:16px; align-items:center;}
  .example-row .lbl{font-size:12px; color:var(--faint); font-family:'JetBrains Mono',monospace; margin-right:4px;}

  .scan-progress{margin-top:24px; padding:24px; font-family:'JetBrains Mono',monospace; font-size:14px; display:flex; flex-direction:column; gap:12px; position:relative; overflow:hidden;}
  .scan-progress .row{display:flex; align-items:center; gap:10px; color:var(--dim); transition:.2s;}
  .scan-progress .row.active-row{color:var(--text);}
  .step-circle{width:14px; height:14px; border-radius:50%; border:1px solid var(--border2); display:inline-block; flex-shrink:0;}

  /* result card */
  .result-card{overflow:hidden;}
  .result-top{padding:28px; display:flex; flex-wrap:wrap; align-items:center; gap:24px; border-bottom:1px solid var(--border);}
  .score-ring{width:112px; height:112px; border-radius:50%; border-width:4px; border-style:solid; display:flex; flex-direction:column; align-items:center; justify-content:center; flex-shrink:0;}
  .score-ring .n{font-family:'Space Grotesk',sans-serif; font-size:30px; font-weight:700;}
  .score-ring .d{font-size:10px; color:var(--faint); font-family:'JetBrains Mono',monospace;}
  .result-mid{flex:1; min-width:200px;}
  .result-mid h2{font-family:'Space Grotesk',sans-serif; font-size:20px; font-weight:600;}
  .result-mid .dom{font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--muted); margin-top:4px;}
  .result-mid .brand-line{font-size:14px; color:var(--muted); margin-top:8px;}
  .result-actions{display:flex; flex-direction:column; gap:8px;}
  .signal-grid{display:grid; grid-template-columns:1fr; gap:1px; background:var(--border);}
  .signal{background:var(--card); padding:16px 20px; display:flex; align-items:center; justify-content:between; justify-content:space-between; gap:12px;}
  .signal .lbl{font-size:14px; color:var(--muted);}
  .signal .val{display:flex; align-items:center; gap:6px; font-size:14px; font-weight:500;}

  /* analysis */
  .big-score-row{display:flex; align-items:center; gap:16px; margin-top:32px;}
  .big-score{font-family:'Space Grotesk',sans-serif; font-size:60px; font-weight:700; color:var(--red);}
  .contrib-row{margin-bottom:16px;}
  .contrib-head{display:flex; justify-content:space-between; font-size:14px; margin-bottom:6px;}
  .contrib-head .name{color:var(--text2);}
  .contrib-head .val{font-family:'JetBrains Mono',monospace; color:var(--muted);}
  .bar-track{height:10px; border-radius:999px; background:var(--border); overflow:hidden;}
  .bar-fill{height:100%; border-radius:999px; background:linear-gradient(90deg,var(--cyan),var(--violet)); width:0; animation:growBar 1s cubic-bezier(.2,.8,.2,1) forwards;}
  @keyframes growBar{from{width:0;}}
  .contrib-total{display:flex; justify-content:space-between; align-items:center; margin-top:20px; padding-top:16px; border-top:1px solid var(--border); font-size:14px;}
  .contrib-total .val{font-family:'JetBrains Mono',monospace; font-weight:600;}
  .explain-box{margin-top:24px; padding:24px; border-radius:12px; background:linear-gradient(135deg,#22D3EE0d,#8B5CF60d); border:1px solid #22D3EE26;}
  .explain-box h3{display:flex; align-items:center; gap:8px; font-size:14px; font-weight:600; margin-bottom:12px;}
  .explain-box p{color:var(--text2); font-size:14px; line-height:1.6;}

  /* attack path */
  .attack-stats{display:flex; flex-wrap:wrap; gap:16px; margin-top:24px;}
  .attack-stat{padding:16px 20px;}
  .attack-stat .lbl{font-size:12px; color:var(--faint); margin-bottom:4px;}
  .attack-stat .val{font-weight:600; color:#f87171; font-family:'Space Grotesk',sans-serif;}
  .attack-chain{position:relative; margin-top:40px;}
  .chain-line{position:absolute; left:24px; top:24px; bottom:24px; width:1px; background:linear-gradient(to bottom, #f59e0b66, #f59e0b66, #ef444490);}
  .chain-list{display:flex; flex-direction:column; gap:24px; position:relative;}
  .chain-item{display:flex; gap:20px; animation:fadeUp .4s ease both;}
  .chain-icon{position:relative; z-index:1; width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; border-width:2px; border-style:solid; flex-shrink:0;}
  .chain-icon.elevated{background:var(--card); border-color:#f59e0b66;}
  .chain-icon.critical{background:#EF44441a; border-color:#ef444480; animation:pathPulse 2s infinite;}
  @keyframes pathPulse{0%{box-shadow:0 0 0 0 rgba(239,68,68,.5);} 70%{box-shadow:0 0 0 10px rgba(239,68,68,0);} 100%{box-shadow:0 0 0 0 rgba(239,68,68,0);}}
  .chain-card{flex:1; border-radius:12px; padding:16px; border:1px solid;}
  .chain-card.elevated{background:var(--card); border-color:var(--border);}
  .chain-card.critical{background:#EF44440f; border-color:#ef444440;}
  .chain-head{display:flex; justify-content:space-between; gap:12px; align-items:center;}
  .chain-head h3{font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:16px;}
  .chain-tag{font-size:10px; font-weight:600; padding:2px 8px; border-radius:999px; border:1px solid; white-space:nowrap;}
  .chain-tag.elevated{color:#fbbf24; border-color:#f59e0b66; background:#F59E0B1a;}
  .chain-tag.critical{color:#f87171; border-color:#ef444466; background:#EF44441a;}
  .chain-desc{font-size:14px; color:var(--muted); margin-top:6px;}

  /* threat intel */
  .ti-stats{display:grid; grid-template-columns:repeat(2,1fr); gap:16px; margin-top:32px;}
  .ti-stat{padding:16px;}
  .ti-stat .val{font-family:'Space Grotesk',sans-serif; font-size:24px; font-weight:600;}
  .ti-stat .lbl{font-size:12px; color:var(--faint); margin-top:4px;}
  .chart-card{padding:24px; margin-top:32px;}
  .chart-card h3{font-size:14px; font-weight:600; color:var(--text2); margin-bottom:16px;}
  .table-toolbar{padding:16px; display:flex; flex-direction:column; gap:12px; border-bottom:1px solid var(--border);}
  .search-box{display:flex; align-items:center; gap:8px; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:8px 12px; flex:1;}
  .search-box input{background:transparent; border:none; outline:none; font-size:14px; flex:1;}
  .search-box input::placeholder{color:var(--faint);}
  .filter-row{display:flex; align-items:center; gap:8px; overflow-x:auto; padding-bottom:2px;}
  .filter-chip{font-size:12px; padding:6px 10px; border-radius:999px; white-space:nowrap; border:1px solid var(--border); color:var(--muted); transition:.15s; flex-shrink:0;}
  .filter-chip.active{background:#22D3EE1a; color:#67e8f9; border-color:#22D3EE4d;}
  table{width:100%; border-collapse:collapse; font-size:14px;}
  thead tr{text-align:left; color:var(--faint); font-size:12px; border-bottom:1px solid var(--border);}
  th{padding:12px 20px; font-weight:500;}
  th button{display:flex; align-items:center; gap:4px;}
  th button:hover{color:var(--text);}
  tbody tr{border-bottom:1px solid var(--border);}
  tbody tr:last-child{border-bottom:none;}
  tbody tr:hover{background:rgba(255,255,255,.02);}
  td{padding:14px 20px;}
  .table-wrap{overflow-x:auto;}

  /* dashboard */
  .dash-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:16px; margin-top:24px;}
  .dash-stat{padding:20px;}
  .dash-stat .val{font-family:'Space Grotesk',sans-serif; font-size:30px; font-weight:600;}
  .dash-stat .lbl{font-size:12px; color:var(--faint); margin-top:6px;}
  .charts-grid{display:grid; grid-template-columns:1fr; gap:24px; margin-top:32px;}
  .legend{display:flex; flex-wrap:wrap; gap:12px; margin-top:12px; font-size:12px; color:var(--muted); justify-content:center;}
  .legend .sw{width:10px; height:10px; border-radius:2px; display:inline-block; margin-right:6px;}
  .tooltip-svg{position:absolute; background:var(--card2); border:1px solid var(--border); border-radius:8px; padding:6px 10px; font-size:12px; pointer-events:none; opacity:0; transition:opacity .1s; z-index:20; white-space:nowrap;}

  /* history */
  .history-list{margin-top:32px;}
  .history-row{display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--border);}